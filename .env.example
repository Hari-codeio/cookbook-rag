# Copy this file to .env and fill in ONE key.
# Only the generation step (eval/run_generation.py, python -m rag.generate) needs it.
# Ingest, search, hit-rate, the filter demo and the chunk-invariant tests all run
# with no key at all, because retrieval is local.

# Default provider. Free tier, no card required.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional alternative. Set GEN_PROVIDER=anthropic to use this instead.
# NOTE: this needs paid API credit. A Claude Pro/Max subscription does NOT
# include API credit; they are billed separately.
# ANTHROPIC_API_KEY=sk-ant-api03-...
# GEN_PROVIDER=anthropic
